# Copy to .env (repo folder or any parent folder):  cp .env.example .env && chmod 600 .env
# .env is gitignored. Never put real keys in any tracked file.

# --- LLM (extraction passes + chat). OpenAI-compatible endpoint serving GPT-6 Astra.
# Optional: without a key, extraction replays the committed cache in var/cache/llm (no cost);
# only new or changed drawings need a key.
OPENAI_API_KEY=
# ASTRA_API_KEY=                      # accepted as an alternative name
# OPENAI_BASE_URL=https://your-gateway/v1
# SR_LLM_MODEL=gpt-6-astra
# SR_LLM_API_STYLE=responses          # responses | chat
# ANTHROPIC_API_KEY=                  # only if llm.provider=anthropic

# --- Neo4j. Leave empty: `sr neo4j-start` generates a random password into var/neo4j/.password.
# Set it only for an existing server (or a shared one).
# SR_NEO4J_PASSWORD=
# SR_NEO4J_URI=bolt://localhost:7687
# SR_NEO4J_USER=neo4j

# --- Engines (override config/settings.yaml)
# CSS_KG_ENABLED=true
# CSS_RAG_ENABLED=true
# SR_RETRIEVAL_MODE=auto              # kg | rag | auto | both
# SR_GRAPH_BACKEND=neo4j              # neo4j | sqlite (tests / offline only)

# --- Paths
# SR_DATA_DIR=/data/substation/css/pdf
# SR_V1_DIR=/data/substation/css/pdf/css_parsed
# SR_VAR_DIR=./var
