# Copy to .env (this folder or any parent folder, e.g. C:\Users\ibpha\work\projects\.env).
# Never commit real keys.

# --- LLM (extraction passes + chat). OpenAI-compatible endpoint serving GPT-6 Astra.
ASTRA_API_KEY=
# OPENAI_API_KEY=                     # accepted as an alternative name
# OPENAI_BASE_URL=https://your-gateway/v1
# SR_LLM_MODEL=gpt-6-astra
# SR_LLM_API_STYLE=responses          # responses | chat
# ANTHROPIC_API_KEY=                  # only if llm.provider=anthropic

# --- Engines (override config/settings.yaml)
# CSS_KG_ENABLED=true
# CSS_RAG_ENABLED=true
# SR_RETRIEVAL_MODE=auto              # kg | rag | auto | both

# --- Graph backend
# SR_GRAPH_BACKEND=sqlite             # sqlite | gremlin
# SR_GREMLIN_URL=ws://localhost:8182/gremlin

# --- Paths
# SR_DATA_DIR=C:/Users/ibpha/work/projects/substation/data/all_data/css/pdf
# SR_VAR_DIR=./var
