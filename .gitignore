# runtime workspace (indexes, graph db, jobs, masks, crops, debug overlays, LLM cache)
var/*
!var/cache/
var/cache/*
!var/cache/llm/
# var/cache/llm/ IS committed: replayed LLM replies, so extraction runs without a key or cost
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
build/
dist/
.uv/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# drawings never go into git
*.pdf
*.dwg
*.dxf
!tests/fixtures/**
